DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketpilot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-key-change-in-production-please
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
APP_NAME=MarketPilot AI
APP_VERSION=1.0.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_REQUEST_SIZE_MB=10
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_RESPONSE_MB=5
